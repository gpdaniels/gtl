        /// @brief  The miller rabin test to evaluate the primality of a number.
        /// @param  random_generator A function that returns 32 uniformly distributed random bits each time it is called.
        /// @param  prime_candidate The prime number candidate to test, must be greater than three.
        /// @param  power_of_two_multiplier Helper variable equal to "(prime_candidate - 1) / (2 ^ power_of_two)" for "power_of_two >= 1"
        /// @return true if the test past and the number could be a prime number, false if the number is definitely not prime.
        static bool miller_rabin(const std::function<unsigned int()>& random_generator, const gtl::big_unsigned& prime_candidate, gtl::big_unsigned power_of_two_multiplier) {
            // Pick a random number in "[2 ... prime_candidate - 2]".
            gtl::big_unsigned base = rsa::generate_random(random_generator, 2, prime_candidate - 1);

            // Compute "(base ^ power_of_two_multiplier) % prime_candidate".
            gtl::big_unsigned test = rsa::modular_exponentiation(base, power_of_two_multiplier, prime_candidate);

            // Corner case checks.
            if ((test == 1) || (test == (prime_candidate - 1))) {
                return true;
            }

            // Keep squaring "test" until:
            // - "power_of_two_multiplier" does not reach "prime_candidate - 1".
            // - "(test ^ 2) % prime_candidate" is not one.
            // - "(test ^ 2) % prime_candidate" is not "prime_candidate - 1".
            while (power_of_two_multiplier != (prime_candidate - 1)) {
                test = (test * test) % prime_candidate;
                power_of_two_multiplier <<= 1;
                if (test == 1) {
                    return false;
                }
                if (test == (prime_candidate - 1)) {
                    return true;
                }
            }
            return false;
        }

        /// @brief  Calculates the greatest common denominator of two big numbers.
        /// @param  value_a One of the numbers to calculate the greatest common denominator of.
        /// @param  value_b One of the numbers to calculate the greatest common denominator of.
        /// @return The greatest common denominator of the two numbers.
        /// @note   Also known as the greatest common devisor, or the highest common factor, or highest common divisor.
        static gtl::big_unsigned greatest_common_denominator(gtl::big_unsigned value_a, gtl::big_unsigned value_b) {
            // Ensure value_a is smaller than value_b.
            if (value_a > value_b) {
                gtl::big_unsigned swap;
                swap = value_a;
                value_a = value_b;
                value_b = swap;
            }
            // Reduce values until remainder is zero.
            while (true) {
                gtl::big_unsigned remainder = value_b % value_a;
                if (remainder == 0) {
                    return value_a;
                }
                value_b = value_a;
                value_a = remainder;
            }
        }

        /// @brief  Calculate the modular multiplicative inverse of a number.
        /// @param  value The value to calculate the modular multiplicative inverse of.
        /// @param  modulus The modulus used in the calculation.
        /// @return The modular multiplicative inverse of the input value.
        /// @note   The modular inverse of "value % modulus" is "value^-1" such that "(value * value^-1) % modulus" is one.
        static gtl::big_unsigned modular_inverse(gtl::big_unsigned value, const gtl::big_unsigned& modulus) {
            GTL_RSA_ASSERT(rsa::greatest_common_denominator(value, modulus) == 1, "Value and modulus must be co-primes.");
            gtl::big_unsigned result = 1;
            gtl::big_unsigned previous = 0;
            gtl::big_unsigned quotient = modulus;
            bool inverse = false;
            while (true) {
                gtl::big_unsigned remainder;
                quotient = gtl::big_unsigned::divide(quotient, value, remainder);
                if (remainder == 0) {
                    if (value != 1) {
                        return 0;
                    }
                    else if (inverse) {
                        return modulus - result;
                    }
                    else {
                        return result;
                    }
                }
                gtl::big_unsigned temp = result;
                result = result * quotient + previous;
                previous = temp;
                quotient = value;
                value = remainder;
                inverse = !inverse;
            }
        }

        /// @brief  Calculate the modular exponentiation of a number.
        /// @param  value The value to calculate the modular exponentiation of.
        /// @param  exponent The exponent to raise the value to.
        /// @param  modulus The modulus used in the calculation.
        /// @return The modular exponentiation of the input value.
        /// @note   The modular exponentiation of "value" is "(value ^ exponent) % modulus".
        static gtl::big_unsigned modular_exponentiation(const gtl::big_unsigned& value, const gtl::big_unsigned& exponent, const gtl::big_unsigned& modulus) {
            gtl::big_unsigned result = 1;
            gtl::big_unsigned square = value;
            long long int bits = static_cast<long long int>(exponent.get_length_bits());
            for (long long int i = bits - 1; i >= 0; --i) {
                if (exponent.get_bit(static_cast<unsigned long long int>(i))) {
                    result = (result * square) % modulus;
                    square = (square * square) % modulus;
                }
                else {
                    square = (result * square) % modulus;
                    result = (result * result) % modulus;
                }
            }
            return result;
        }

    private:
        /// @brief  Check if a value can be transformed with a modulus and written to a buffer.
        /// @param  value The value to transform.
        /// @param  modulus The modulus used to transform the value.
        /// @param  length The length of the buffer that will receive the transformed value.
        /// @return true if the modulus is usable, the value is less than the modulus, and any transformed value fits in the buffer.
        static bool is_transformable(const gtl::big_unsigned& value, const gtl::big_unsigned& modulus, const unsigned int length) {
            return (modulus > 1) && (value < modulus) && (modulus.get_length_bytes() <= length);
        }

        /// @brief  Perform the private key operation, raising a value to the power of the private exponent.
        /// @param  value The value to transform, must be less than the modulus.
        /// @param  private_key The private key.
        /// @return The value raised to the power of the private exponent, modulo the modulus.
        static gtl::big_unsigned private_operation(const gtl::big_unsigned& value, const private_key_type& private_key) {
            // If the key has them, use the primes to split the operation into two with half the size, using the chinese remainder theorem.
            const bool has_primes =
                (private_key.primes[0] != 0) &&
                (private_key.primes[1] != 0) &&
                (private_key.exponents[0] != 0) &&
                (private_key.exponents[1] != 0) &&
                (private_key.coefficient != 0) &&
                (private_key.public_exponent != 0);
            if (has_primes) {
                const gtl::big_unsigned result_0 = rsa::modular_exponentiation(value % private_key.primes[0], private_key.exponents[0], private_key.primes[0]);
                const gtl::big_unsigned result_1 = rsa::modular_exponentiation(value % private_key.primes[1], private_key.exponents[1], private_key.primes[1]);
                // Combine the results, the subtraction is kept positive by adding the prime.
                const gtl::big_unsigned difference = (result_0 + private_key.primes[0] - (result_1 % private_key.primes[0])) % private_key.primes[0];
                const gtl::big_unsigned result = result_1 + (((private_key.coefficient * difference) % private_key.primes[0]) * private_key.primes[1]);
                // Verify the result using the public key before returning it.
                // A result that is wrong, from a fault or from inconsistent key data, would otherwise reveal the primes.
                if ((result < private_key.public_modulus) && (rsa::modular_exponentiation(result, private_key.public_exponent, private_key.public_modulus) == value)) {
                    return result;
                }
            }
            return rsa::modular_exponentiation(value, private_key.private_exponent, private_key.public_modulus);
        }

        /// @brief  Perform the private key operation on a value that is first hidden by multiplying it with a random number.
        /// @param  random_generator A function that returns 32 uniformly distributed random bits each time it is called.
        /// @param  value The value to transform, must be less than the modulus.
        /// @param  private_key The private key, the public exponent must be set.
        /// @param  result The value raised to the power of the private exponent, modulo the modulus.
        /// @return true if the operation was performed, false if the key cannot be used for blinding.
        /// @note   The time taken by the private key operation depends on its input, blinding stops that time from being related to the value.
        static bool private_operation_blinded(const std::function<unsigned int()>& random_generator, const gtl::big_unsigned& value, const private_key_type& private_key, gtl::big_unsigned& result) {
            if ((!random_generator) || (private_key.public_exponent == 0) || (private_key.public_modulus < 4)) {
                return false;
            }
            // Pick a random number that has an inverse, for a real key every number other than a multiple of the primes does.
            gtl::big_unsigned blind;
            do {
                blind = rsa::generate_random(random_generator, 2, private_key.public_modulus);
            } while (rsa::greatest_common_denominator(blind, private_key.public_modulus) != 1);
            const gtl::big_unsigned unblind = rsa::modular_inverse(blind, private_key.public_modulus);
            // Multiplying by "blind ^ public_exponent" before the operation multiplies the result by "blind".
            const gtl::big_unsigned blinded = (value * rsa::modular_exponentiation(blind, private_key.public_exponent, private_key.public_modulus)) % private_key.public_modulus;
            result = (rsa::private_operation(blinded, private_key) * unblind) % private_key.public_modulus;
            return true;
        }

        /// @brief  Perform the private key operation, with blinding if a random generator is provided.
        /// @param  random_generator Null, or a function that returns 32 uniformly distributed random bits each time it is called.
        /// @param  value The value to transform, must be less than the modulus.
        /// @param  private_key The private key.
        /// @param  result The value raised to the power of the private exponent, modulo the modulus.
        /// @return true if the operation was performed, false if blinding was requested but the key cannot be used for blinding.
        static bool private_operation(const std::function<unsigned int()>* random_generator, const gtl::big_unsigned& value, const private_key_type& private_key, gtl::big_unsigned& result) {
            if (random_generator != nullptr) {
                return rsa::private_operation_blinded(*random_generator, value, private_key, result);
            }
            result = rsa::private_operation(value, private_key);
            return true;
        }

        /// @brief  The mask generation function MGF1 of RFC 8017 using sha2-256, xoring the mask into a buffer.
        /// @param  seed The seed that the mask is generated from.
        /// @param  seed_length The length of the seed.
        /// @param  output The buffer that the mask is xored into.
        /// @param  output_length The length of the buffer.
        static void xor_mask(const unsigned char* seed, const unsigned int seed_length, unsigned char* output, const unsigned int output_length) {
            unsigned int counter = 0;
            for (unsigned int offset = 0; offset < output_length; ++counter) {
                const unsigned char counter_bytes[4] = {
                    static_cast<unsigned char>((counter >> 24) & 0xFF),
                    static_cast<unsigned char>((counter >> 16) & 0xFF),
                    static_cast<unsigned char>((counter >> 8) & 0xFF),
                    static_cast<unsigned char>((counter >> 0) & 0xFF)
                };
                gtl::sha2<256> hash_function;
                hash_function.reset();
                hash_function.consume(reinterpret_cast<const char*>(seed), seed_length);
                hash_function.consume(reinterpret_cast<const char*>(counter_bytes), 4);
                hash_function.finalise();
                for (unsigned int i = 0; (i < gtl::sha2<256>::hash_size) && (offset < output_length); ++i, ++offset) {
                    output[offset] ^= hash_function.get_hash().data[i];
                }
            }
        }

        /// @brief  Decrypt a block of data that was encrypted with optimal asymmetric encryption padding.
        /// @param  random_generator Null, or a function that returns 32 uniformly distributed random bits each time it is called.
        /// @see    decrypt_oaep
        static bool decrypt_oaep_block(const std::function<unsigned int()>* random_generator, const unsigned char* data, const unsigned int length, const private_key_type& private_key, unsigned char* output, unsigned int& output_length, const unsigned char* label, const unsigned int label_length) {
            constexpr const unsigned int hash_size = static_cast<unsigned int>(gtl::sha2<256>::hash_size);
            output_length = 0;
            // The encrypted data is always exactly as long as the modulus.
            if ((length < rsa::oaep_overhead) || (private_key.public_modulus.get_length_bytes() != length)) {
                return false;
            }
            const gtl::big_unsigned value(data, length);
            if (!rsa::is_transformable(value, private_key.public_modulus, length)) {
                return false;
            }
            gtl::big_unsigned result;
            if (!rsa::private_operation(random_generator, value, private_key, result)) {
                return false;
            }
            // The encoded message is a zero byte, the masked seed, then the masked data block.
            std::vector<unsigned char> encoded(length, 0);
            result.to_bytes(encoded.data(), length, true);
            unsigned char* seed = &encoded[1];
            unsigned char* data_block = &encoded[1 + hash_size];
            const unsigned int data_block_length = length - hash_size - 1;
            rsa::xor_mask(data_block, data_block_length, seed, hash_size);
            rsa::xor_mask(seed, hash_size, data_block, data_block_length);
            // The data block is the hash of the label, padding zeros, a one byte, then the message.
            // Every check is made before deciding if the data is valid, so that the reason for a failure is not revealed.
            const typename gtl::sha2<256>::hash_type label_hash = gtl::sha2<256>::hash(reinterpret_cast<const char*>(label), label_length);
            unsigned int invalid = encoded[0];
            for (unsigned int i = 0; i < hash_size; ++i) {
                invalid |= static_cast<unsigned int>(data_block[i] ^ label_hash.data[i]);
            }
            unsigned int message_offset = 0;
            unsigned int searching = 1;
            for (unsigned int i = hash_size; i < data_block_length; ++i) {
                const unsigned int is_one = (data_block[i] == 0x01) ? 1u : 0u;
                const unsigned int is_zero = (data_block[i] == 0x00) ? 1u : 0u;
                // The first non zero byte must be the one byte that marks the start of the message.
                message_offset |= (searching & is_one) * (i + 1);
                invalid |= searching & (1u - is_one) & (1u - is_zero);
                searching &= is_zero;
            }
            invalid |= searching;
            if (invalid != 0) {
                return false;
            }
            output_length = data_block_length - message_offset;
            for (unsigned int i = 0; i < output_length; ++i) {
                output[i] = data_block[message_offset + i];
            }
            return true;
        }

    public:
        /// @brief  Generate a public and private key set.
        /// @param  random_generator A function that returns 32 uniformly distributed random bits each time it is called, the keys are only as unpredictable as its output.
        /// @param  size_bytes The number of bytes in the keys, must be an even number greater than zero.
        /// @param  exponent The public exponent, must be an odd number greater than one.
        /// @param  miller_rabin_iterations The number of miller rabin test iterations to validate primality.
        /// @return A public and private key set, or if any argument is invalid a key set where every value is zero.
        static key_type generate_key_pair(const std::function<unsigned int()>& random_generator, unsigned int size_bytes, unsigned int exponent = 65537, unsigned int miller_rabin_iterations = 64) {
            key_type keys;
            if ((!random_generator) || (size_bytes < 2) || ((size_bytes % 2) != 0) || (exponent < 3) || ((exponent % 2) == 0)) {
                return keys;
            }
            keys.private_key.public_exponent = exponent;
            keys.public_key.public_exponent = exponent;
            gtl::big_unsigned phi;
            do {
                keys.private_key.primes[0] = rsa::generate_prime(random_generator, size_bytes / 2, miller_rabin_iterations);
                keys.private_key.primes[1] = rsa::generate_prime(random_generator, size_bytes / 2, miller_rabin_iterations);
                keys.private_key.public_modulus = keys.private_key.primes[0] * keys.private_key.primes[1];
                keys.public_key.public_modulus = keys.private_key.public_modulus;
                phi = (keys.private_key.primes[0] - 1) * (keys.private_key.primes[1] - 1);
            } while (
                (keys.private_key.primes[0] == keys.private_key.primes[1]) ||
                (rsa::greatest_common_denominator(phi, exponent) != 1)
            );
            keys.private_key.private_exponent = rsa::modular_inverse(keys.public_key.public_exponent, phi);
            keys.private_key.exponents[0] = keys.private_key.private_exponent % (keys.private_key.primes[0] - 1);
            keys.private_key.exponents[1] = keys.private_key.private_exponent % (keys.private_key.primes[1] - 1);
            keys.private_key.coefficient = rsa::modular_inverse(keys.private_key.primes[1], keys.private_key.primes[0]);
            return keys;
        }

    public:
        /// @brief  Transform a block of data writing the transformed data into the output.
        /// @param  data The block of data to encrypt, must be at least length bytes long, and as a big endian number must be less than the modulus.
        /// @param  length The length of the data, must be equal to the key length.
        /// @param  exponent Exponent used to transform the data, must be length bytes long.
        /// @param  modulus Modulus used to transform the data, must be length bytes long.
        /// @param  output Pointer to an output buffer that will receive the transformed data, must be at least length bytes long
        /// @return true if the data was transformed, false if the data is not less than the modulus in which case the output is not written.
        /// @note   For encryption the exponent is the public exponent, and modulus is the public modulus.
        /// @note   For decryption the exponent is the private exponent, and modulus is the public modulus.
        static bool transform_block(const unsigned char* data, const unsigned int length, const unsigned char* exponent, const unsigned char* modulus, unsigned char* output) {
            const gtl::big_unsigned value(data, length);
            const gtl::big_unsigned modulus_value(modulus, length);
            if (!rsa::is_transformable(value, modulus_value, length)) {
                return false;
            }
            rsa::modular_exponentiation(value, gtl::big_unsigned(exponent, length), modulus_value).to_bytes(output, length, true);
            return true;
        }

    public:
        /// @brief  Encrypt a block of data, writing the encrypted data into the output.
        /// @param  data The block of data to encrypt, must be at least length bytes long, and as a big endian number must be less than the modulus.
        /// @param  length The length of the data, must be equal to the key length.
        /// @param  public_key The public key data used to encrypt the data.
        /// @param  output Pointer to an output buffer that will receive the encrypted data, must be at least length bytes long.
        /// @return true if the data was encrypted, false if the data is not less than the modulus or the key is longer than the length, in which case the output is not written.
        /// @note   This is the raw rsa operation with no padding, to encrypt a message use encrypt_oaep.
        static bool encrypt(const unsigned char* data, const unsigned int length, const public_key_type& public_key, unsigned char* output) {
            const gtl::big_unsigned value(data, length);
            if (!rsa::is_transformable(value, public_key.public_modulus, length)) {
                return false;
            }
            rsa::modular_exponentiation(value, public_key.public_exponent, public_key.public_modulus).to_bytes(output, length, true);
            return true;
        }

        /// @brief  Decrypt a block of data, writing the decrypted data into the output.
        /// @param  data The block of data to decrypt, must be at least length bytes long, and as a big endian number must be less than the modulus.
        /// @param  length The length of the data, must be equal to the key length.
        /// @param  private_key The private key data used to decrypt the data.
        /// @param  output Pointer to an output buffer that will receive the decrypted data, must be at least length bytes long.
        /// @return true if the data was decrypted, false if the data is not less than the modulus or the key is longer than the length, in which case the output is not written.
        /// @note   This is the raw rsa operation with no padding, to decrypt a message use decrypt_oaep.
        /// @note   The time this takes depends on the data and the private key, use the overload with a random generator if that time can be observed.
        static bool decrypt(const unsigned char* data, const unsigned int length, const private_key_type& private_key, unsigned char* output) {
            const gtl::big_unsigned value(data, length);
            if (!rsa::is_transformable(value, private_key.public_modulus, length)) {
                return false;
            }
            rsa::private_operation(value, private_key).to_bytes(output, length, true);
            return true;
        }

        /// @brief  Decrypt a block of data with the private key operation blinded, writing the decrypted data into the output.
        /// @param  random_generator A function that returns 32 uniformly distributed random bits each time it is called.
        /// @param  data The block of data to decrypt, must be at least length bytes long, and as a big endian number must be less than the modulus.
        /// @param  length The length of the data, must be equal to the key length.
        /// @param  private_key The private key data used to decrypt the data, the public exponent must be set.
        /// @param  output Pointer to an output buffer that will receive the decrypted data, must be at least length bytes long.
        /// @return true if the data was decrypted, false if the data is not less than the modulus, the key is longer than the length, or the key has no public exponent, in which case the output is not written.
        /// @note   This is the raw rsa operation with no padding, to decrypt a message use decrypt_oaep.
        static bool decrypt(const std::function<unsigned int()>& random_generator, const unsigned char* data, const unsigned int length, const private_key_type& private_key, unsigned char* output) {
            const gtl::big_unsigned value(data, length);
            if (!rsa::is_transformable(value, private_key.public_modulus, length)) {
                return false;
            }
            gtl::big_unsigned result;
            if (!rsa::private_operation_blinded(random_generator, value, private_key, result)) {
                return false;
            }
            result.to_bytes(output, length, true);
            return true;
        }

    public:
        /// @brief  Encrypt a message using the optimal asymmetric encryption padding of RFC 8017 with sha2-256, writing the encrypted data into the output.
        /// @param  random_generator A function that returns 32 uniformly distributed random bits each time it is called.
        /// @param  message The message to encrypt.
        /// @param  message_length The length of the message, must be no more than length minus oaep_overhead.
        /// @param  public_key The public key data used to encrypt the message.
        /// @param  output Pointer to an output buffer that will receive the encrypted data, must be length bytes long.
        /// @param  length The length of the output, must be equal to the key length.
        /// @param  label Optional data that is not encrypted but must be provided again to decrypt the message.
        /// @param  label_length The length of the label.
        /// @return true if the message was encrypted, false if the message is too long or the length is not the key length, in which case the output is not written.
        static bool encrypt_oaep(const std::function<unsigned int()>& random_generator, const unsigned char* message, const unsigned int message_length, const public_key_type& public_key, unsigned char* output, const unsigned int length, const unsigned char* label = nullptr, const unsigned int label_length = 0) {
            constexpr const unsigned int hash_size = static_cast<unsigned int>(gtl::sha2<256>::hash_size);
            if ((!random_generator) || (length < rsa::oaep_overhead) || (message_length > (length - rsa::oaep_overhead)) || (public_key.public_modulus.get_length_bytes() != length)) {
                return false;
            }
            // The encoded message is a zero byte, the masked seed, then the masked data block.
            std::vector<unsigned char> encoded(length, 0);
            unsigned char* seed = &encoded[1];
            unsigned char* data_block = &encoded[1 + hash_size];
            const unsigned int data_block_length = length - hash_size - 1;
            // The data block is the hash of the label, padding zeros, a one byte, then the message.
            const typename gtl::sha2<256>::hash_type label_hash = gtl::sha2<256>::hash(reinterpret_cast<const char*>(label), label_length);
            for (unsigned int i = 0; i < hash_size; ++i) {
                data_block[i] = label_hash.data[i];
            }
            data_block[data_block_length - message_length - 1] = 0x01;
            for (unsigned int i = 0; i < message_length; ++i) {
                data_block[data_block_length - message_length + i] = message[i];
            }
            // The seed is random, so that encrypting the same message twice gives different data.
            for (unsigned int i = 0; i < hash_size; i += 4) {
                const unsigned int random = random_generator();
                seed[i + 0] = static_cast<unsigned char>((random >> 24) & 0xFF);
                seed[i + 1] = static_cast<unsigned char>((random >> 16) & 0xFF);
                seed[i + 2] = static_cast<unsigned char>((random >> 8) & 0xFF);
                seed[i + 3] = static_cast<unsigned char>((random >> 0) & 0xFF);
            }
            rsa::xor_mask(seed, hash_size, data_block, data_block_length);
            rsa::xor_mask(data_block, data_block_length, seed, hash_size);
            // The leading zero byte ensures that the encoded message is less than the modulus.
            rsa::modular_exponentiation(gtl::big_unsigned(encoded.data(), length), public_key.public_exponent, public_key.public_modulus).to_bytes(output, length, true);
            return true;
        }

        /// @brief  Decrypt a message that was encrypted using the optimal asymmetric encryption padding of RFC 8017 with sha2-256, writing the message into the output.
        /// @param  data The encrypted data to decrypt.
        /// @param  length The length of the data, must be equal to the key length.
        /// @param  private_key The private key data used to decrypt the data.
        /// @param  output Pointer to an output buffer that will receive the message, must be at least length minus oaep_overhead bytes long.
        /// @param  output_length Receives the length of the message, or zero if the data is not valid.
        /// @param  label The label that was provided when the message was encrypted.
        /// @param  label_length The length of the label.
        /// @return true if the data was valid and decrypted, false otherwise in which case the output is not written.
        /// @note   The time this takes depends on the data and the private key, use the overload with a random generator if that time can be observed.
        static bool decrypt_oaep(const unsigned char* data, const unsigned int length, const private_key_type& private_key, unsigned char* output, unsigned int& output_length, const unsigned char* label = nullptr, const unsigned int label_length = 0) {
            return rsa::decrypt_oaep_block(nullptr, data, length, private_key, output, output_length, label, label_length);
        }

        /// @brief  Decrypt a message that was encrypted using the optimal asymmetric encryption padding of RFC 8017 with sha2-256, with the private key operation blinded.
        /// @param  random_generator A function that returns 32 uniformly distributed random bits each time it is called.
        /// @param  data The encrypted data to decrypt.
        /// @param  length The length of the data, must be equal to the key length.
        /// @param  private_key The private key data used to decrypt the data, the public exponent must be set.
        /// @param  output Pointer to an output buffer that will receive the message, must be at least length minus oaep_overhead bytes long.
        /// @param  output_length Receives the length of the message, or zero if the data is not valid.
        /// @param  label The label that was provided when the message was encrypted.
        /// @param  label_length The length of the label.
        /// @return true if the data was valid and decrypted, false otherwise in which case the output is not written.
        static bool decrypt_oaep(const std::function<unsigned int()>& random_generator, const unsigned char* data, const unsigned int length, const private_key_type& private_key, unsigned char* output, unsigned int& output_length, const unsigned char* label = nullptr, const unsigned int label_length = 0) {
            return rsa::decrypt_oaep_block(&random_generator, data, length, private_key, output, output_length, label, label_length);
        }
    };
}

