#define GTL_PROTOCOL_TLS_TLS_HANDSHAKE_HPP

// Summary: The definitions, message encodings, and cryptographic helpers shared by the handshakes of the transport layer security protocol.

#include <crypto/asymmetric/elliptic_curve>
#include <crypto/asymmetric/x25519>
#include <crypto/certificate/x509>
#include <crypto/hash/sha2>
#include <crypto/mac/hmac>
