#pragma once
#ifndef GTL_CRYPTO_AES_HPP
#define GTL_CRYPTO_AES_HPP

// Summary: An implementation of the aes encryption algorithm for 128, 192, and 256 bits.

namespace gtl {
    /// @brief  The aes class computes an encrypted output from a sequence of data.
    /// @tparam aes_size The size of the key length used in the aes algorithm.
    template <unsigned long long int aes_size>
    class aes final {
    private:
        static_assert(aes_size % 8 == 0, "Size of aes key must be a multiple of eight.");
        static_assert(aes_size == 128 || aes_size == 192 || aes_size == 256, "Currently only sizes 128, 192, and 256 bits are supported.");

    public:
        /// @brief  Handy variable for accessing the size in bits.
        constexpr static const unsigned long long int size = aes_size;

        /// @brief  Internal size of each processed block of data in sets of four bytes, a block is block_size by block_size bytes.
        constexpr static const unsigned int block_size = 32 / 8;

        /// @brief  Size of each processed block of data in bytes.
        constexpr static const unsigned int block_size_bytes = aes::block_size * aes::block_size;

        /// @brief  Size of the key in bytes.
        constexpr static const unsigned int key_size = aes::size / 8;

        /// @brief  The number of encryption/decryption rounds.
        constexpr static const int number_of_rounds = 6 + (aes::size / 32);

    public:
        /// @brief  Type used to hold words of data for processing.
        struct word_type {
            unsigned char data[aes::block_size] = {};
        };

        /// @brief  Type used to hold blocks of data for processing.
        struct block_type {
            /// @brief  The data stored in the block.
            word_type data[aes::block_size] = { {} };
        };

        /// @brief  Simple type to hold the key data.
        struct key_type {
            unsigned char data[aes::key_size] = {};
        };

        /// @brief  Type used to hold a key that has been expanded into the keys for each round.
        struct round_keys_type {
            block_type data[aes::number_of_rounds + 1] = { {} };
        };

    private:
        /// @brief  Handle raising the degree of the polynomial represented by the aes irreducible polynomial and bits in the input.
        /// @param  polynomial Bits representing the powers of a polynomial.
        /// @return Result of raising the degree of the polynomial represented by the aes irreducible polynomial and bits in the input.
        constexpr static unsigned char polynomial_raise(const unsigned char polynomial) {
            // The aes irreducible polynomial used is:
            // x^8 + x^4 + x^3 + x + 1 or 0b0000000100011011 or 0x011B
            //
            // The aim is to reduce the polynomial to degree 7 (to fit in 1 byte).
            // A byte can be represented by each bits bool value:
            // b7*x^7 + b6*x^6 + b5*x^5 + b4*x^4 + b3*x^3 + b2*x^2 + b1*x^1 + b0*x^0
            //
            // Which when multiplied by x becomes:
            // b7*x^8 + b6*x^7 + b5*x^6 + b4*x^5 + b3*x^4 + b2*x^3 + b1*x^2 + b0*x^1
            //
            // This is equivalent to a shifted of 1 bit to the left.

            // Check if the high bit is set, as this would shift off the side
            if (polynomial & 0x80) {
                // If set it is necessary to apply the modulo with the irreducible polynomial, achieved by xor.
                return static_cast<unsigned char>(polynomial << 1) ^ 0x1B;
            }
            else {
                // If not set the polynomial is already reduced.
                return static_cast<unsigned char>(polynomial << 1);
            }
        }

    private:
        // The substitution box is computed for eight bytes at a time, packed into a 64 bit value, and not read from a table.
        // A table lookup is indexed by key dependent data, so the time it takes leaks information about the key through the cache.
        // The computation below has no branches or memory accesses that depend on the data.

        /// @brief  Raise the degree of eight packed polynomials, the packed equivalent of polynomial_raise.
        /// @param  polynomials Eight polynomials, one per byte.
        /// @return Each of the eight polynomials multiplied by x and reduced by the aes irreducible polynomial.
        constexpr static unsigned long long int polynomial_raise_packed(const unsigned long long int polynomials) {
            return ((polynomials & 0x7F7F7F7F7F7F7F7Full) << 1) ^ (((polynomials >> 7) & 0x0101010101010101ull) * 0x1Bull);
        }

        /// @brief  Multiply eight packed polynomials by eight packed polynomials, the packed equivalent of polynomial_multiply.
        /// @param  lhs_polynomials The lhs of the polynomial multiplications, one per byte.
        /// @param  rhs_polynomials The rhs of the polynomial multiplications, one per byte.
        /// @return The eight results of the polynomial multiply operations, one per byte.
        constexpr static unsigned long long int polynomial_multiply_packed(unsigned long long int lhs_polynomials, const unsigned long long int rhs_polynomials) {
            unsigned long long int result = 0;
            for (unsigned int i = 0; i < 8; ++i) {
                // Each byte of the mask is 0xFF if bit i of the matching rhs byte is set, otherwise 0x00.
                result ^= lhs_polynomials & (((rhs_polynomials >> i) & 0x0101010101010101ull) * 0xFFull);
                lhs_polynomials = aes::polynomial_raise_packed(lhs_polynomials);
            }
            return result;
        }

        /// @brief  Raise eight packed polynomials to a power that is a power of two.
        /// @param  polynomials Eight polynomials, one per byte.
        /// @param  powers The value of each of x^0 to x^7 after being raised to the power.
        /// @return Each of the eight polynomials raised to the power.
        /// @note   Raising to a power of two is linear, so the result is the sum of the raised value of each term of the polynomial.
        constexpr static unsigned long long int polynomial_power_packed(const unsigned long long int polynomials, const unsigned char powers[8]) {
            unsigned long long int result = 0;
            for (unsigned int i = 0; i < 8; ++i) {
                // Each byte of the selection is 0x01 if bit i of the matching byte is set, otherwise 0x00.
                result ^= ((polynomials >> i) & 0x0101010101010101ull) * powers[i];
            }
            return result;
        }

        /// @brief  Calculate the multiplicative inverse of eight packed polynomials.
        /// @param  polynomials Eight polynomials, one per byte.
        /// @return The multiplicative inverse of each polynomial, where the inverse of zero is zero.
        constexpr static unsigned long long int polynomial_inverse_packed(const unsigned long long int polynomials) {
            // The values of x^0 to x^7 raised to the powers of 2, 4, and 16, reduced by the aes irreducible polynomial.
            constexpr const unsigned char powers_2[8] = { 0x01, 0x04, 0x10, 0x40, 0x1B, 0x6C, 0xAB, 0x9A };
            constexpr const unsigned char powers_4[8] = { 0x01, 0x10, 0x1B, 0xAB, 0x5E, 0x97, 0xB3, 0xC5 };
            constexpr const unsigned char powers_16[8] = { 0x01, 0x5E, 0xE4, 0xE8, 0x4D, 0x91, 0x1D, 0x6C };
            // The multiplicative group has 255 elements, so the inverse of a polynomial is the polynomial raised to the power of 254.
            const unsigned long long int power_2 = aes::polynomial_power_packed(polynomials, powers_2);
            const unsigned long long int power_3 = aes::polynomial_multiply_packed(power_2, polynomials);
            const unsigned long long int power_12 = aes::polynomial_power_packed(power_3, powers_4);
            const unsigned long long int power_15 = aes::polynomial_multiply_packed(power_12, power_3);
            const unsigned long long int power_240 = aes::polynomial_power_packed(power_15, powers_16);
            const unsigned long long int power_252 = aes::polynomial_multiply_packed(power_240, power_12);
            return aes::polynomial_multiply_packed(power_252, power_2);
        }

        /// @brief  Circular rotate left the bits of each of eight packed bytes.
        /// @param  bytes Eight bytes.
        /// @param  shift Number of bits to rotate each byte, must be between one and seven.
        /// @return The eight rotated bytes.
        constexpr static unsigned long long int rotate_bits_packed(const unsigned long long int bytes, const unsigned int shift) {
            const unsigned long long int mask_high = ((0xFFull << shift) & 0xFFull) * 0x0101010101010101ull;
            const unsigned long long int mask_low = (0xFFull >> (8 - shift)) * 0x0101010101010101ull;
            return ((bytes << shift) & mask_high) | ((bytes >> (8 - shift)) & mask_low);
        }

        /// @brief  Substitute eight packed bytes with their equivalent from the forward substitution box.
        /// @param  bytes Eight bytes.
        /// @return The eight substituted bytes.
        constexpr static unsigned long long int substitute_forward_packed(const unsigned long long int bytes) {
            // The forward substitution box is the multiplicative inverse followed by an affine transformation.
            const unsigned long long int inverse = aes::polynomial_inverse_packed(bytes);
            return inverse ^ aes::rotate_bits_packed(inverse, 1) ^ aes::rotate_bits_packed(inverse, 2) ^ aes::rotate_bits_packed(inverse, 3) ^ aes::rotate_bits_packed(inverse, 4) ^ 0x6363636363636363ull;
        }

        /// @brief  Substitute eight packed bytes with their equivalent from the inverse substitution box.
        /// @param  bytes Eight bytes.
        /// @return The eight substituted bytes.
        constexpr static unsigned long long int substitute_inverse_packed(const unsigned long long int bytes) {
            // The inverse substitution box is the inverse affine transformation followed by the multiplicative inverse.
            return aes::polynomial_inverse_packed(aes::rotate_bits_packed(bytes, 1) ^ aes::rotate_bits_packed(bytes, 3) ^ aes::rotate_bits_packed(bytes, 6) ^ 0x0505050505050505ull);
        }

        /// @brief  Pack two words into a 64 bit value.
        /// @param  word_low The word packed into the low half of the value.
        /// @param  word_high The word packed into the high half of the value.
        /// @return The packed value.
        constexpr static unsigned long long int pack_words(const word_type& word_low, const word_type& word_high) {
            unsigned long long int packed = 0;
            for (unsigned int i = 0; i < aes::block_size; ++i) {
                packed |= static_cast<unsigned long long int>(word_low.data[i]) << (8 * i);
                packed |= static_cast<unsigned long long int>(word_high.data[i]) << (8 * (i + aes::block_size));
            }
            return packed;
        }

        /// @brief  Unpack two words from a 64 bit value.
        /// @param  packed The packed value.
        /// @param  word_low The word unpacked from the low half of the value.
        /// @param  word_high The word unpacked from the high half of the value.
        constexpr static void unpack_words(const unsigned long long int packed, word_type& word_low, word_type& word_high) {
            for (unsigned int i = 0; i < aes::block_size; ++i) {
                word_low.data[i] = static_cast<unsigned char>((packed >> (8 * i)) & 0xFF);
                word_high.data[i] = static_cast<unsigned char>((packed >> (8 * (i + aes::block_size))) & 0xFF);
            }
        }

    private:
        /// @brief  Circular rotate of an input word by a number of bytes.
        /// @param  word Data to byte rotate.
        /// @param  shift Number of bytes to rotate the input word.
        /// @return The rotated word.
        constexpr static word_type rotate_left(const word_type& word, unsigned int shift) {
            return word_type{
                { word.data[(0 + shift) % aes::block_size],
                  word.data[(1 + shift) % aes::block_size],
                  word.data[(2 + shift) % aes::block_size],
                  word.data[(3 + shift) % aes::block_size] }
            };
        }

        /// @brief  Calculate the round constant for a given round number.
        /// @param  round_number The round number to compute the round constant for.
        /// @return The value of the round constant as the first byte in a word.
        constexpr static word_type round_constant(const unsigned int round_number) {
            word_type constant = {
                { 1, 0, 0, 0 }
            };
            for (unsigned int round = 1; round < round_number; ++round) {
                constant.data[0] = polynomial_raise(constant.data[0]);
            }
            return constant;
        }

        /// @brief  Expand the input key into the number of blocks required for all rounds of aes.
        /// @param  key The input key.
        /// @param  round_keys The result of expanding the key.
        constexpr static void key_expansion(const key_type& key, block_type round_keys[aes::number_of_rounds + 1]) {
            // round_keys_rows[i] means a row of the round_keys data (32 bits)
            // round_keys_rows[i] = key_rows[i]                                                                                     : (i < key_size_words)
            // round_keys_rows[i] = round_keys_rows[i - key_size_words] ^ Sub(Rot(round_keys_rows[i - 1])) ^ round_constant(i / N)  : (i >= key_size_words) && (i % key_size_words == 0)
            // round_keys_rows[i] = round_keys_rows[i - key_size_words] ^ Sub(round_keys_rows[i - 1])                               : (i >= key_size_words) && (key_size_words > 6) && (i % key_size_words == 4)
            // round_keys_rows[i] = round_keys_rows[i - key_size_words] ^ round_keys_rows[i - 1]                                    : otherwise

            // Copy key into the blocks of round_keys.
            for (unsigned int key_index = 0; key_index < aes::key_size; key_index += aes::block_size) {
                const unsigned int round_index = key_index / (aes::block_size * aes::block_size);
                const unsigned int block_column_index = (key_index % (aes::block_size * aes::block_size)) / (aes::block_size);
                round_keys[round_index].data[0].data[block_column_index] = key.data[key_index + 0];
                round_keys[round_index].data[1].data[block_column_index] = key.data[key_index + 1];
                round_keys[round_index].data[2].data[block_column_index] = key.data[key_index + 2];
                round_keys[round_index].data[3].data[block_column_index] = key.data[key_index + 3];
            }

            // Mutating the round_keys.
            for (unsigned int key_index = aes::key_size; key_index < aes::block_size * aes::block_size * (aes::number_of_rounds + 1); key_index += aes::block_size) {
                const unsigned int round_index = key_index / (aes::block_size * aes::block_size);
                const unsigned int block_column_index = (key_index % (aes::block_size * aes::block_size)) / (aes::block_size);

                const unsigned int previous_block_column_round_index = (key_index - aes::block_size) / (aes::block_size * aes::block_size);
                const unsigned int previous_block_column_index = ((key_index - aes::block_size) % (aes::block_size * aes::block_size)) / (aes::block_size);

                word_type previous_round_key_word = {
                    { round_keys[previous_block_column_round_index].data[0].data[previous_block_column_index],
                      round_keys[previous_block_column_round_index].data[1].data[previous_block_column_index],
                      round_keys[previous_block_column_round_index].data[2].data[previous_block_column_index],
                      round_keys[previous_block_column_round_index].data[3].data[previous_block_column_index] }
                };

                if ((key_index % aes::key_size) == 0) {
                    previous_round_key_word = aes::rotate_left(previous_round_key_word, 1);
                    aes::substitute_forward(previous_round_key_word);
                    word_type round_constant_word = aes::round_constant(key_index / aes::key_size);
                    previous_round_key_word = aes::xor_data(previous_round_key_word, round_constant_word);
                }
                else if constexpr ((aes::key_size / aes::block_size) > 6) {
                    if ((key_index % aes::key_size) == (aes::block_size * aes::block_size)) {
                        aes::substitute_forward(previous_round_key_word);
                    }
                }

                const unsigned int key_round_index = (key_index - aes::key_size) / (aes::block_size * aes::block_size);
                const unsigned int key_block_column_index = ((key_index - aes::key_size) % (aes::block_size * aes::block_size)) / (aes::block_size);

                round_keys[round_index].data[0].data[block_column_index] = round_keys[key_round_index].data[0].data[key_block_column_index] ^ previous_round_key_word.data[0];
                round_keys[round_index].data[1].data[block_column_index] = round_keys[key_round_index].data[1].data[key_block_column_index] ^ previous_round_key_word.data[1];
                round_keys[round_index].data[2].data[block_column_index] = round_keys[key_round_index].data[2].data[key_block_column_index] ^ previous_round_key_word.data[2];
                round_keys[round_index].data[3].data[block_column_index] = round_keys[key_round_index].data[3].data[key_block_column_index] ^ previous_round_key_word.data[3];
            }
        }

    private:
        /// @brief  Substitute all bytes in a word with their equivalent from the forward substitution box.
        /// @param  word Data to substitute.
        constexpr static void substitute_forward(word_type& word) {
            word_type unused = {};
            aes::unpack_words(aes::substitute_forward_packed(aes::pack_words(word, unused)), word, unused);
        }

        /// @brief  Substitute all bytes in a word with their equivalent from the inverse substitution box.
        /// @param  word Data to substitute.
        constexpr static void substitute_inverse(word_type& word) {
            word_type unused = {};
            aes::unpack_words(aes::substitute_inverse_packed(aes::pack_words(word, unused)), word, unused);
        }

        /// @brief  Substitute all bytes in a block with their equivalent from the forward substitution box.
        /// @param  block Data to substitute.
        constexpr static void substitute_forward(block_type& block) {
            for (unsigned int i = 0; i < aes::block_size; i += 2) {
                aes::unpack_words(aes::substitute_forward_packed(aes::pack_words(block.data[i], block.data[i + 1])), block.data[i], block.data[i + 1]);
            }
        }

        /// @brief  Substitute all bytes in a block with their equivalent from the inverse substitution box.
        /// @param  block Data to substitute.
        constexpr static void substitute_inverse(block_type& block) {
            for (unsigned int i = 0; i < aes::block_size; i += 2) {
                aes::unpack_words(aes::substitute_inverse_packed(aes::pack_words(block.data[i], block.data[i + 1])), block.data[i], block.data[i + 1]);
            }
        }

        /// @brief  Mix all columns of a block using the forward transformation.
        /// @param  block Data to mix.
        constexpr static void mix_columns_forward(block_type& block) {
            // Each output row is "(0x02 * row) ^ (0x03 * next_row) ^ other_row ^ another_row" for all columns at once.
            // Which is rearranged to "row ^ all_rows ^ (0x02 * (row ^ next_row))" where "all_rows" is the xor of the four rows.
            const unsigned long long int rows_01 = aes::pack_words(block.data[0], block.data[1]);
            const unsigned long long int rows_12 = aes::pack_words(block.data[1], block.data[2]);
            const unsigned long long int rows_23 = aes::pack_words(block.data[2], block.data[3]);
            const unsigned long long int rows_30 = aes::pack_words(block.data[3], block.data[0]);
            const unsigned long long int rows_all = rows_01 ^ rows_23 ^ ((rows_01 ^ rows_23) >> 32) ^ ((rows_01 ^ rows_23) << 32);
            aes::unpack_words(rows_01 ^ rows_all ^ aes::polynomial_raise_packed(rows_01 ^ rows_12), block.data[0], block.data[1]);
            aes::unpack_words(rows_23 ^ rows_all ^ aes::polynomial_raise_packed(rows_23 ^ rows_30), block.data[2], block.data[3]);
        }

        /// @brief  Mix all columns of a block using the inverse transformation.
        /// @param  block Data to mix.
        constexpr static void mix_columns_inverse(block_type& block) {
            // The inverse transformation is the forward transformation applied after xoring "0x04 * (row ^ row_after_next)" into each row.
            const unsigned long long int rows_01 = aes::pack_words(block.data[0], block.data[1]);
            const unsigned long long int rows_23 = aes::pack_words(block.data[2], block.data[3]);
            const unsigned long long int raised = aes::polynomial_raise_packed(aes::polynomial_raise_packed(rows_01 ^ rows_23));
            aes::unpack_words(rows_01 ^ raised, block.data[0], block.data[1]);
            aes::unpack_words(rows_23 ^ raised, block.data[2], block.data[3]);
            aes::mix_columns_forward(block);
        }

        /// @brief  Rotate all rows of a block using the forward transformation.
        /// @param  block Data to rotate.
        constexpr static void rotate_rows_forward(block_type& block) {
            // block.data[0] = aes::rotate_left(block.data[0], 0);
            block.data[1] = aes::rotate_left(block.data[1], 1);
            block.data[2] = aes::rotate_left(block.data[2], 2);
            block.data[3] = aes::rotate_left(block.data[3], 3);
        }

        /// @brief  Rotate all rows of a block using the inverse transformation.
        /// @param  block Data to rotate.
        constexpr static void rotate_rows_inverse(block_type& block) {
            // block.data[0] = aes::rotate_left(block.data[0], 4);
            block.data[1] = aes::rotate_left(block.data[1], 3);
            block.data[2] = aes::rotate_left(block.data[2], 2);
            block.data[3] = aes::rotate_left(block.data[3], 1);
        }

    private:
        /// @brief  Calculate and return the byte by byte xor of the lhs and rhs words.
        /// @param  lhs The lhs word.
        /// @param  rhs The rhs word.
        /// @return A word containing the byte by byte xor of the lhs and rhs words.
        constexpr static word_type xor_data(const word_type& lhs, const word_type& rhs) {
            word_type result;
            for (unsigned int i = 0; i < aes::block_size; ++i) {
                result.data[i] = lhs.data[i] ^ rhs.data[i];
            }
            return result;
        }

        /// @brief  Calculate and return the byte by byte xor of the lhs and rhs blocks.
        /// @param  lhs The lhs block.
        /// @param  rhs The rhs block.
        /// @return A word containing the byte by byte xor of the lhs and rhs blocks.
        constexpr static block_type xor_data(const block_type& lhs, const block_type& rhs) {
            block_type result;
            for (unsigned int i = 0; i < aes::block_size; ++i) {
                result.data[i] = xor_data(lhs.data[i], rhs.data[i]);
            }
            return result;
        }

    public:
        /// @brief  Expand a key into the keys for each round, so that many blocks can be transformed without repeating the expansion.
        /// @param  key The input key.
        /// @return The keys for each round.
        constexpr static round_keys_type expand_key(const key_type& key) {
            round_keys_type round_keys;
            aes::key_expansion(key, round_keys.data);
            return round_keys;
        }

        /// @brief  Transform a block of data from decrypted to encrypted.
        /// @param  round_keys The expanded key used to encrypt the data.
        /// @param  data Data to encrypt.
        /// @return The encrypted data.
        constexpr static block_type encrypt_block(const round_keys_type& round_keys, const block_type& data) {
            block_type state = data;

            state = aes::xor_data(round_keys.data[0], state);

            for (unsigned int round = 1; round < aes::number_of_rounds; ++round) {
                aes::substitute_forward(state);
                aes::rotate_rows_forward(state);
                aes::mix_columns_forward(state);
                state = aes::xor_data(round_keys.data[round], state);
            }

            aes::substitute_forward(state);
            aes::rotate_rows_forward(state);
            state = aes::xor_data(round_keys.data[aes::number_of_rounds], state);

            return state;
        }

        /// @brief  Transform a block of data from encrypted to decrypted.
        /// @param  round_keys The expanded key used to decrypt the data.
        /// @param  data Data to decrypt.
        /// @return The decrypted data.
        constexpr static block_type decrypt_block(const round_keys_type& round_keys, const block_type& data) {
            block_type state = data;

            state = aes::xor_data(round_keys.data[aes::number_of_rounds], state);

            for (unsigned int round = aes::number_of_rounds - 1; round > 0; --round) {
                aes::substitute_inverse(state);
                aes::rotate_rows_inverse(state);
                state = aes::xor_data(round_keys.data[round], state);
                aes::mix_columns_inverse(state);
            }

            aes::substitute_inverse(state);
            aes::rotate_rows_inverse(state);
            state = aes::xor_data(round_keys.data[0], state);

            return state;
        }

        /// @brief  Transform a block of data from decrypted to encrypted.
        /// @param  key The input key used to encrypt the data.
        /// @param  data Data to encrypt.
        /// @return The encrypted data.
        /// @note   This expands the key every call, to transform many blocks expand the key once using expand_key.
        constexpr static block_type encrypt_block(const key_type& key, const block_type& data) {
            return aes::encrypt_block(aes::expand_key(key), data);
        }

        /// @brief  Transform a block of data from encrypted to decrypted.
        /// @param  key The input key used to decrypt the data.
        /// @param  data Data to decrypt.
        /// @return The decrypted data.
        /// @note   This expands the key every call, to transform many blocks expand the key once using expand_key.
        constexpr static block_type decrypt_block(const key_type& key, const block_type& data) {
            return aes::decrypt_block(aes::expand_key(key), data);
        }
    };
}

#endif // GTL_CRYPTO_AES_HPP
