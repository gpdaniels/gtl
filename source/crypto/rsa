namespace gtl {
    /// @brief  The rsa class implements all the routines needed to generate primes and used them to perform asymmetric encryption.
    /// @note   The encrypt, decrypt, and transform_block functions are the raw rsa operation with no padding.
    /// @note   The raw operation is deterministic and malleable, so to encrypt messages use encrypt_oaep and decrypt_oaep.
    /// @note   The big number arithmetic is not constant time, use the decrypt functions that take a random generator to blind the private key operation.
    class rsa final {
    public:
        /// @brief  The number of bytes of an encrypted block that are used by the optimal asymmetric encryption padding.
        /// @note   The longest message that fits in a key is the key length in bytes minus this overhead.
        constexpr static const unsigned int oaep_overhead = (2 * (256 / 8)) + 2;

    public:
        /// @brief  The public key is used to encrypt data or verify signed data.
        class public_key_type final {
        public:
            gtl::big_unsigned public_modulus;
            gtl::big_unsigned public_exponent;
        };

        /// @brief  The private key is used to decrypt data or sign data.
        /// @note   Only the public_modulus and private_exponent are needed for decryption.
        /// @note   If the primes, exponents, coefficient, and public_exponent are all set they are used to decrypt around four times faster.
        /// @note   The public_exponent is also needed to blind the private key operation.
        class private_key_type final {
        public:
            gtl::big_unsigned public_modulus;
            gtl::big_unsigned public_exponent;
            gtl::big_unsigned private_exponent;
            gtl::big_unsigned primes[2];
            gtl::big_unsigned exponents[2];
            gtl::big_unsigned coefficient;
        };

        /// @brief  Storage class for a public and private key pair.
        class key_type final {
        public:
            public_key_type public_key;
            private_key_type private_key;
        };

    private:
        /// @brief  Generate a random big number.
        /// @param  random_generator A function that returns 32 uniformly distributed random bits each time it is called.
        /// @param  minimum The lower inclusive bound for the returned random number.
        /// @param  maximum The upper exclusive bound for the returned random number, must be greater than the minimum.
        /// @return A random number between the (inclusive) minimum and (exclusive) maximum bounds.
        static gtl::big_unsigned generate_random(const std::function<unsigned int()>& random_generator, const gtl::big_unsigned& minimum, const gtl::big_unsigned& maximum) {
            GTL_RSA_ASSERT(minimum < maximum, "The minimum must be less than the maximum.");
            const gtl::big_unsigned range = maximum - minimum;
            // Generate 64 more bits than the range needs, so that the bias from reducing the random bits into the range is negligible.
            const unsigned long long int chunks = (range.get_length_bits() / gtl::big_unsigned::chunk_bits) + 3;
            gtl::big_unsigned random(0u);
            for (unsigned long long int chunk = 0; chunk < chunks; ++chunk) {
                random = (random << gtl::big_unsigned::chunk_bits) | random_generator();
            }
            return minimum + (random % range);
        }

        /// @brief  Generate a random prime number.
        /// @param  random_generator A function that returns 32 uniformly distributed random bits each time it is called.
        /// @param  size_bytes The number of bytes in the prime, must be greater than zero.
        /// @param  miller_rabin_iterations The number of miller rabin test iterations to validate primality.
        /// @return A random prime number.
        static gtl::big_unsigned generate_prime(const std::function<unsigned int()>& random_generator, unsigned int size_bytes, unsigned int miller_rabin_iterations) {
            gtl::big_unsigned prime;
            do {
                // Generate a number.
                prime = rsa::generate_random(random_generator, 1u, gtl::big_unsigned(1u) << (size_bytes * 8));
                // Ensure it's got the lsb and the two msbs set, aka odd and full size.
                // With the two msbs set the product of two primes is always the full size, with only the msb set it can be one bit short.
                prime |= (gtl::big_unsigned(1u) << ((size_bytes * 8u) - 1u)) | (gtl::big_unsigned(1u) << ((size_bytes * 8u) - 2u)) | 1u;
                // Check if the number is prime, if not try again.
            } while (!rsa::is_prime(random_generator, prime, miller_rabin_iterations));
            return prime;
        }

